---
import { Image } from "astro:assets";
import jimothy from "../assets/jimothy.png";

interface Props {
	id: string,
	username: string,
	profile_picture_url: string,
	description: string,
	signature: string,
	created_at: string
};

const { id, username, profile_picture_url, description, signature, created_at } = Astro.props;
const createdAtString = new Date(created_at).toLocaleDateString(undefined);
const profilePictureUrl = (profile_picture_url != "" ? profile_picture_url : jimothy) as string;
---

<div class="user-result-card">
	<a class="main-link" href={"/users/@" + username}></a>
    <div class="user-result">
        <div class="user-result-header">
			<div class="user-result-header-header">
				<Image src={profilePictureUrl} width={32} height={32} alt={username}></Image>
				<h3>{username}</h3>
			</div>
            <h3>{createdAtString}</h3>
        </div>
        <div class="user-result-body">
            <p>{description}</p>
            {signature != "" && (
                <>
                <hr class="contrast-hr">
                <div class="user-result-signature" set:html={signature}></div>
                </>
            )}
        </div>
    </div>
</div>

<style>
	.user-result-card {
        position: relative;
    }

	.user-result {
		display: flex;
		flex-direction: column;
		background-color: grey;
		box-shadow: 4px 4px 0px 0px black;
		padding: 10px;
	}

	.user-result-header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
	}

	.user-result-header-header {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.main-link {
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .user-result-signature :global(a) {
        position: relative;
        z-index: 2;
    }
</style>
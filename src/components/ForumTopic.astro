---
interface Props {
	forum: string;
	name: string;
	description: string;
	totalPosts: number;
	locked: boolean;
	creatorID: string;
	createdAt: string;
}
const { forum, name, description, totalPosts, locked, creatorID, createdAt } = Astro.props;
---
<a class="link-nostyle" href={`/forums/forum/${forum}/topics/topic/${name}`}>
	<div class="forum-topic">
		<div class="forum-topic-header">
			<h3 class="forum-topic-title">{name}</h3>
			<h3 class="forum-topic-totalposts">{totalPosts + (totalPosts == 1 ? " Post" : " Posts")}</h3>
		</div>
		<p class="forum-topic-description">{description}</p>
	</div>
</a>

<style>
	.forum-topic {
		background-color: grey;
		box-shadow: 4px 4px 0px 0px black;
		padding: 10px;
	}

	.forum-topic-header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
	}

	.forum-topic-title {
		margin: 0px;
	}

	.forum-topic-description:empty {
		margin: 0px;
	}
</style>
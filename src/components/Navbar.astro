---
import { apiGetBinary } from '../scripts/common.js';

const userID = "abcdefgh";
const pfpResponse = await apiGetBinary("/forums/users/" + userID + "/image", {});
const arrayBuffer = await pfpResponse.data;
let pfpUrl = "/default-avatar.png";

if (!pfpResponse.error) {
    const base64 = Buffer.from(pfpResponse.data).toString('base64');
    pfpUrl = `data:image/png;base64,${base64}`;
}
---

<nav id="navbar">
	<div>

	</div>
	<a href={`/user/@${userID}`}><img src={pfpUrl} alt="Your Profile Picture"></a>
</nav>

<style>
	#navbar {
		height: 60px;
		width: 100%;
		display: flex;
		flex-direction: row;
		background-color: black;
	}
</style>

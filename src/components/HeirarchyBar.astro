---
interface Props {
	forum: string | undefined;
	topic: string | undefined;
}
const { forum, topic } = Astro.props;

const first = forum != undefined ? ">" : "";
const second = topic != undefined ? ">" : "";
---

<h1><a class="link-nostyle" href="/forums">All Forums</a> {first} <a class="link-nostyle" href={"/forums/forum/" + forum}>{forum ?? ""}</a> {second} <a class="link-nostyle" href={"/forums/forum/" + forum + "/topics/topic/" + topic}>{topic ?? ""}</a></h1>


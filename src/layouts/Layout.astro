---
import "../styles/styles.css";
import Navbar from "../components/Navbar.astro";
interface Props {
	preface?: boolean;
  	title: string;
	section: string;
}
const { preface, title: rawTitle, section } = Astro.props;
const pageTitle = preface ? "FruitBowlForums" + (rawTitle.length > 1 ? " - " : "") + rawTitle : rawTitle;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="author" content="Kiwian">
		<meta name="description" content="The most beautiful forums site you may ever lay your eyes upon.">
		<link rel="icon" href="/favicon.ico">
		<script src="../scripts/common.js"></script>
		<title>{pageTitle}</title>
	</head>
	<body id={section + "-body"}>
		<div>
			<Navbar section={section}></Navbar>
			<main id={section + "-main"}>
				<slot name="header"/>
				<slot/>
			</main>
		</div>
	</body>
</html>
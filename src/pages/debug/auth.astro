---
import Layout from "../../layouts/Layout.astro";
import api from "../../scripts/common";

const auth = await api("auth", {}, "GET", Astro.request);
---

<Layout preface={true} title="Auth Debug">
	<h1>{auth.data.loggedIn == false ? "Not Logged In" : "Logged In"}</h1>
	<h1>{auth.data.username ?? "N/A"}</h1>
</Layout>
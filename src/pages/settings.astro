---
import Layout from "../layouts/Layout.astro";
import api from "../scripts/common";

const response = await api(Astro.response, "fruitbowl/", "users/self", {}, "GET", Astro.request);
const username = response.data.username;
const description = response.data.description;
const signature = response.data.signature;
if (response.error) {
	if (response.status == -1) {
		return Astro.rewrite("503");
	} else {
		return Astro.redirect("500");
	}
}
---

<Layout preface={true} title="Settings" section={"forums"}>
	<div id="session-data" data-username={username}></div>

	<h1>Settings</h1>
	<p id="status"></p>
	<form id="settings-form" class="alone-form">
		<aside>Leave any fields you don't wish to update blank.</aside>

		<label for="username-input">New Username: </label>
		<input id="username-input" name="username" value={username} autocomplete="off">

		<label for="description-input">New Description: </label>
		<textarea id="description-input" name="description" autocomplete="off">{description}</textarea>

		<label for="signature-input">New Signature: </label>
		<textarea id="signature-input" name="signature" autocomplete="off">{signature}</textarea>

		<button type="submit">Save</button>
	</form>
</Layout>

<script>
	import api from "../scripts/common";

	const form = document.getElementById("settings-form")! as HTMLFormElement;
	const status = document.getElementById("status")!;

	const username = document.getElementById("session-data")?.dataset.username;

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		const formData = new FormData(form);
		const response = await api(undefined, "forums/", "users/self", formData, "PUT");
		if (response.error) {
			status.innerText = "Encountered an error while updating settings: " + response.data;
		} else {
			const targetUsername = formData.get("username") || username;
			window.location.href = "/users/@" + targetUsername;
		}
	});
</script>
---
import Layout from "../layouts/Layout.astro";
import api from "../scripts/common";

const response = await api(Astro.response, "fruitbowl/", "auth", {}, "GET", Astro.request);
---

<Layout preface={true} title="" section={"fruitbowl"}>
	<h1>Welcome to FruitBowl</h1>
	<p>This is an experimental all-in-one social media platform. Fruitbowl aims to combine ProtoCall, KiwiBlog, and BlueberryForums (to be renamed) into one unifed place.</p>
</Layout>
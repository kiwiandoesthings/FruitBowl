---
import Layout from "../../../../../layouts/Layout.astro";
import ChatArea from "../../../../../components/ChatArea";

const roomID = Astro.params.room as string;
---

<Layout preface={true} title={""} section="chat">
	<div id="room-area">
		<div id="rooms-column">

		</div>
		<div id="chat-column">
			<ChatArea roomID={roomID} client:load></ChatArea>
		</div>
		<div id="users-column">

		</div>
	</div>
</Layout>

<style>
	#room-area {
		flex: 1;
		display: flex;
		flex-direction: row;
		min-height: 0;
	}

	#rooms-column {
		flex: 0 0 20%;
		background-color: lightgrey;
	}

	#chat-column {
		flex: 0 0 60%;
		display: flex;
		flex-direction: column;
		background-color: rgb(63, 63, 63);
		min-height: 0;
	}

	#users-column {
		flex: 0 0 20%;
		background-color: lightgrey;
	}
</style>
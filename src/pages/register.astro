---
import Layout from "../layouts/Layout.astro";
---

<Layout preface={true} title="Register">
	<h1>Register</h1>
	<p id="status"></p>
	<form id="register-form" class="alone-form">
        <label for="username-input">Username: </label>
    	<input id="username-input" name="username" autocomplete="off">

        <label for="password-input">Password: </label>
        <input id="password-input" name="password" type="password" autocomplete="off">

		<div class="form-file-input">
			<label for="profile-picture-input">Profile Picture: </label>
			<button id="file-upload-button" type="button">Choose File</button>
			<span id="file-name">No file chosen</span>
        	<input id="profile-picture-input" type="file" name="profilePicture" accept="image/*">
		</div>

		<button type="submit">Register</button>
	</form>
</Layout>

<script>
	import api from "../scripts/common";

	const form = document.getElementById("register-form")! as HTMLFormElement;
	const status = document.getElementById("status")!;

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		const formData = new FormData(form);
		const response = await api("users", formData, "POST");
		if (response.error) {
			status.innerText = "Encountered an error while registering: " + response.data;
		} else {
			window.location.href = "/users/@" + formData.get("username");
		}
	});

	const uploadButton = document.getElementById("file-upload-button")!;
	const fileInput = document.getElementById('profile-picture-input') as HTMLInputElement;
	const fileNameSpan = document.getElementById('file-name')!;

	fileInput.addEventListener('change', () => {
    	if (fileInput.files && fileInput.files.length > 0) {
        	fileNameSpan.innerText = fileInput.files[0].name;
    	} else {
        	fileNameSpan.innerText = "No file chosen";
    	}
	});

	uploadButton.addEventListener("click", () => {
    	fileInput.click();
	});
</script>

<style>
	#profile-picture-input {
    	display: none;
	}

	#file-upload-button {
    	appearance: button;
    	-webkit-appearance: button;
    	-moz-appearance: button;
	}

	#file-upload-button:active {
    	
	}
</style>